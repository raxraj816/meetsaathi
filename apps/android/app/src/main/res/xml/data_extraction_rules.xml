<?xml version="1.0" encoding="utf-8"?>
<!-- Spooled audio, tokens and notes are never included in cloud backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" path="." /><exclude domain="file" path="." /><exclude domain="sharedpref" path="." /></cloud-backup>
    <device-transfer><exclude domain="root" path="." /><exclude domain="file" path="." /><exclude domain="sharedpref" path="." /></device-transfer>
</data-extraction-rules>

# Local development only. Copy to infra/.env; production uses Secrets Manager and infra/terraform.
MS_ENV=dev
POSTGRES_PASSWORD=postgres_dev_only
MS_DATABASE_OWNER_URL=postgresql://postgres:postgres_dev_only@db:5432/meetsaathi
MS_APP_DB_PASSWORD=ms_app_dev_only
MS_WORKER_DB_PASSWORD=ms_worker_dev_only
MS_DATABASE_APP_URL=postgresql://ms_app:ms_app_dev_only@db:5432/meetsaathi
MS_DATABASE_WORKER_URL=postgresql://ms_worker:ms_worker_dev_only@db:5432/meetsaathi
MS_OBJECT_STORE_DIR=/var/lib/meetsaathi/objects
MS_OBJECT_STORE_BACKEND=local
MS_QUEUE_BACKEND=postgres
MS_AWS_REGION=ap-south-1
MS_PROCESSING_REGION=ap-south-1
MS_ALLOWED_REGIONS=ap-south-1
# Explicitly opt in to AWS services with a locally configured AWS profile, or use ECS task roles.
MS_REASONER_PROVIDER=bedrock
MS_BEDROCK_MODEL_ID=
MS_ASR_PROVIDER=amazon-transcribe
MS_TRANSCRIBE_ENABLED=false
MS_TRANSCRIBE_LANGUAGE_CODE=en-IN
MS_TRANSCRIBE_LANGUAGE_OPTIONS=en-IN,hi-IN
# To enable S3: backend=s3, bucket and KMS key are all required.
MS_S3_BUCKET=
MS_S3_KMS_KEY_ID=
# To enable SQS: queue_backend=sqs and queue_url are both required.
MS_SQS_QUEUE_URL=
# Separate Nemotron service; no guessed speakers when absent.
MS_DIARIZER_URL=
MS_DIARIZER_REGION=ap-south-1
# Optional alternate providers require an explicit provider selection (see ADR-017).
MS_ANTHROPIC_API_KEY=
MS_REASONER_MODEL=claude-opus-5-5
MS_REASONER_REGION=ap-south-1
MS_ASR_BASE_URL=
MS_ASR_API_KEY=
MS_ASR_MODEL=whisper-1
MS_ASR_REGION=ap-south-1
MS_EMBEDDING_BASE_URL=
MS_EMBEDDING_API_KEY=
MS_EMBEDDING_MODEL=text-embedding-3-small
MS_EMBEDDING_REGION=ap-south-1
MS_TELEMETRY_ENABLED=false
